generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String           @id @default(cuid())
  email          String           @unique
  name           String?
  avatar         String?
  password       String?
  role           Role             @default(USER)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  activities     Activity[]       @relation("UserActivities")
  comments       Comment[]        @relation("CommentAuthor")
  mentionedIn    CommentMention[]
  documents      Document[]
  leaveBalance   LeaveBalance?
  leaveDecisions LeaveRequest[]   @relation("LeaveApprovedBy")
  leaveRequests  LeaveRequest[]   @relation("UserLeaveRequests")
  assignedTasks  Task[]           @relation("UserTasks")
  workflows      Workflow[]       @relation("UserWorkflows")
}

model Workflow {
  id           String                 @id @default(cuid())
  title        String
  description  String?
  priority     Priority               @default(MEDIUM)
  stage        Stage                  @default(TODO)
  assigneeId   String?
  team         String?
  tags         String
  dueDate      DateTime?
  progress     Int                    @default(0)
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
  completedAt  DateTime?
  activities   Activity[]             @relation("WorkflowActivities")
  comments     Comment[]
  documents    Document[]
  files        File[]
  tasks        Task[]                 @relation("WorkflowTasks")
  assignee     User?                  @relation("UserWorkflows", fields: [assigneeId], references: [id])
  stageHistory WorkflowStageHistory[]
}

model File {
  id           String   @id @default(cuid())
  filename     String
  originalName String
  url          String
  size         Int
  mimeType     String
  workflowId   String
  uploadedBy   String?
  createdAt    DateTime @default(now())
  workflow     Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
}

model Task {
  id         String   @id @default(cuid())
  title      String
  completed  Boolean  @default(false)
  workflowId String
  assigneeId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  assignee   User?    @relation("UserTasks", fields: [assigneeId], references: [id])
  workflow   Workflow @relation("WorkflowTasks", fields: [workflowId], references: [id])
}

model Activity {
  id         String   @id @default(cuid())
  action     String
  details    String?
  userId     String?
  workflowId String
  metadata   String?
  createdAt  DateTime @default(now())
  user       User?    @relation("UserActivities", fields: [userId], references: [id])
  workflow   Workflow @relation("WorkflowActivities", fields: [workflowId], references: [id])
}

model Notification {
  id          String    @id @default(cuid())
  type        NotifType
  title       String
  message     String
  read        Boolean   @default(false)
  userId      String?
  workflowId  String?
  createdAt   DateTime  @default(now())
  emailSent   Boolean   @default(false)
  emailSentAt DateTime?
  emailError  String?
}

model Comment {
  id         String           @id @default(cuid())
  body       String
  authorId   String?
  workflowId String
  createdAt  DateTime         @default(now())
  author     User?            @relation("CommentAuthor", fields: [authorId], references: [id])
  workflow   Workflow         @relation(fields: [workflowId], references: [id])
  mentions   CommentMention[]
}

model CommentMention {
  id        String  @id @default(cuid())
  commentId String
  userId    String
  comment   Comment @relation(fields: [commentId], references: [id])
  user      User    @relation(fields: [userId], references: [id])
}

model WorkflowStageHistory {
  id         String    @id @default(cuid())
  workflowId String
  stage      String
  enteredAt  DateTime  @default(now())
  exitedAt   DateTime?
  workflow   Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@index([stage])
  @@index([enteredAt])
}

model Document {
  id         String    @id @default(cuid())
  name       String
  fileUrl    String
  fileType   String    @default("Other")
  fileSize   String    @default("0 KB")
  project    String
  workflowId String?
  uploadedBy String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User?     @relation(fields: [uploadedBy], references: [id])
  workflow   Workflow? @relation(fields: [workflowId], references: [id])
}

model LeaveRequest {
  id          String       @id @default(cuid())
  userId      String
  type        LeaveType
  startDate   DateTime
  endDate     DateTime
  reason      String?
  status      LeaveStatus  @default(PENDING)
  managerNote String?
  isHalfDay   Boolean      @default(false)
  halfDayType HalfDayType?
  reviewerId  String?
  reviewedAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  reviewer    User?        @relation("LeaveApprovedBy", fields: [reviewerId], references: [id])
  user        User         @relation("UserLeaveRequests", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([startDate])
}

model LeaveBalance {
  id                  String   @id @default(cuid())
  userId              String   @unique
  annualEntitlement   Float    @default(20)
  annualUsed          Float    @default(0)
  annualCarryOver     Float    @default(0)
  sickEntitlement     Float    @default(10)
  sickUsed            Float    @default(0)
  sickCarryOver       Float    @default(0)
  personalEntitlement Float    @default(3)
  personalUsed        Float    @default(0)
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  ADMIN
  MANAGER
  USER
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}

enum Stage {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
  BLOCKED
}

enum NotifType {
  STATUS_CHANGE
  ASSIGNED
  TASK_COMPLETED
  OVERDUE
  MENTION
}

enum LeaveType {
  ANNUAL
  SICK
  PERSONAL
  MATERNITY
  PATERNITY
  UNPAID
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  DENIED
}

enum HalfDayType {
  MORNING
  AFTERNOON
}
