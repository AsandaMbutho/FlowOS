generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  USER
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}

enum Stage {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
  BLOCKED
}

enum NotifType {
  STATUS_CHANGE
  ASSIGNED
  TASK_COMPLETED
  OVERDUE
  MENTION
}

enum LeaveType {
  ANNUAL
  SICK
  PERSONAL
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id       String  @id @default(cuid())
  email    String  @unique
  name     String?
  avatar   String?
  password String?
  role     Role    @default(USER)

  workflows     Workflow[]       @relation("UserWorkflows")
  assignedTasks Task[]           @relation("UserTasks")
  activities    Activity[]       @relation("UserActivities")
  comments      Comment[]        @relation("CommentAuthor")
  mentionedIn   CommentMention[]
  documents     Document[]

  leaveRequests  LeaveRequest[] @relation("UserLeaveRequests")
  leaveDecisions LeaveRequest[] @relation("LeaveApprovedBy")
  leaveBalance   LeaveBalance?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Workflow {
  id          String     @id @default(cuid())
  title       String
  description String?
  priority    Priority   @default(MEDIUM)
  stage       Stage      @default(TODO)
  assigneeId  String?
  assignee    User?      @relation("UserWorkflows", fields: [assigneeId], references: [id])
  team        String?
  tags        String
  dueDate     DateTime?
  progress    Int        @default(0)
  completedAt DateTime?
  tasks       Task[]     @relation("WorkflowTasks")
  activities  Activity[] @relation("WorkflowActivities")
  comments    Comment[]
  files       File[]
  documents   Document[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  stageHistory WorkflowStageHistory[]
}

model File {
  id           String   @id @default(cuid())
  filename     String
  originalName String
  url          String
  size         Int
  mimeType     String
  workflowId   String
  workflow     Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  uploadedBy   String?
  createdAt    DateTime @default(now())

  @@index([workflowId])
}

model Task {
  id         String   @id @default(cuid())
  title      String
  completed  Boolean  @default(false)
  workflowId String
  workflow   Workflow @relation("WorkflowTasks", fields: [workflowId], references: [id])
  assigneeId String?
  assignee   User?    @relation("UserTasks", fields: [assigneeId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Activity {
  id         String   @id @default(cuid())
  action     String
  details    String?
  userId     String?
  user       User?    @relation("UserActivities", fields: [userId], references: [id])
  workflowId String
  workflow   Workflow @relation("WorkflowActivities", fields: [workflowId], references: [id])
  metadata   String?
  createdAt  DateTime @default(now())
}

model Notification {
  id          String    @id @default(cuid())
  type        NotifType
  title       String
  message     String
  read        Boolean   @default(false)
  userId      String?
  workflowId  String?
  createdAt   DateTime  @default(now())
  emailSent   Boolean   @default(false)
  emailSentAt DateTime?
  emailError  String?
}

model Comment {
  id         String   @id @default(cuid())
  body       String
  authorId   String?
  workflowId String
  createdAt  DateTime @default(now())

  author   User?    @relation("CommentAuthor", fields: [authorId], references: [id])
  workflow Workflow @relation(fields: [workflowId], references: [id])

  mentions CommentMention[]
}

model CommentMention {
  id        String @id @default(cuid())
  commentId String
  userId    String

  comment Comment @relation(fields: [commentId], references: [id])
  user    User    @relation(fields: [userId], references: [id])
}

model WorkflowStageHistory {
  id         String    @id @default(cuid())
  workflowId String
  workflow   Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  stage      String
  enteredAt  DateTime  @default(now())
  exitedAt   DateTime?

  @@index([workflowId])
  @@index([stage])
  @@index([enteredAt])
}

model Document {
  id         String    @id @default(cuid())
  name       String
  fileUrl    String
  fileType   String    @default("Other")
  fileSize   String    @default("0 KB")
  project    String
  workflowId String?
  workflow   Workflow? @relation(fields: [workflowId], references: [id], onDelete: SetNull)
  uploadedBy String?
  user       User?     @relation(fields: [uploadedBy], references: [id])
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model LeaveRequest {
  id String @id @default(cuid())

  userId String
  user   User   @relation("UserLeaveRequests", fields: [userId], references: [id], onDelete: Cascade)

  type      LeaveType   @default(SICK)
  startDate DateTime
  endDate   DateTime
  reason    String      @db.Text
  status    LeaveStatus @default(PENDING)

  isHalfDay   Boolean @default(false)
  halfDayType String?

  doctorsNoteDataUrl String? @db.Text
  doctorsNoteName    String?

  managerNote String? @db.Text

  reviewerId String?
  reviewer   User?     @relation("LeaveApprovedBy", fields: [reviewerId], references: [id])
  reviewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([startDate])
}

model LeaveBalance {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  annualEntitlement Float @default(20)
  annualUsed        Float @default(0)
  annualCarryOver   Float @default(0)

  sickEntitlement Float @default(10)
  sickUsed        Float @default(0)
  sickCarryOver   Float @default(0)

  personalEntitlement Float @default(3)
  personalUsed        Float @default(0)

  updatedAt DateTime @updatedAt
}
